# ---- This machine ----
# Linux user that owns the repo and runs the stack's services.
STACK_USER=YOUR_USER
# The Pi's hostname (also its Tailscale MagicDNS name). Check with: hostname
HOST_NAME=YOUR_HOSTNAME
# This machine's Tailscale address. Check with: tailscale ip -4
TAILSCALE_IP=100.x.y.z
# Where the media disk is mounted (default /mnt/storage). It must be a real mount point: the stack
# refuses to start without it, so media never lands on the system disk. On a single-disk machine
# bind-mount a folder there (fstab: /srv/media /mnt/storage none bind 0 0).
STORAGE_MOUNT=/mnt/storage
# Filesystem UUID of a media drive switched on by hand, so it mounts on power-on (lsblk -f).
# Leave empty when the disk is always mounted through fstab.
STORAGE_UUID=
# The media drive's whole-disk device for Scrutiny's SMART history (default /dev/sda); a stable
# /dev/disk/by-id/... path survives device reordering. ls -l /dev/disk/by-id/
STORAGE_DEVICE=
# Every URL Questarr is opened on (hostname, hostname.local, LAN IP, Tailscale IP), port 5000.
QUESTARR_ALLOWED_ORIGINS=http://YOUR_HOSTNAME:5000,http://YOUR_HOSTNAME.local:5000,http://LAN_IP:5000,http://TAILSCALE_IP:5000,http://localhost:5000

# ---- Identity / permissions ----
# Must match the owner of DATA_ROOT. Check with: id
PUID=1000
PGID=1000
# 002 => new files are group-writable, so every container can import each other's files.
UMASK=002
# Your time zone, e.g. Europe/Amsterdam or America/New_York (timedatectl list-timezones).
TZ=Etc/UTC
# The weather on Glance's start page, in single quotes when it has spaces: 'Amsterdam, Netherlands'.
WEATHER_LOCATION=

# ---- Paths ----
# Single mount holding BOTH downloads and media, so hardlinks work. Do not split these.
DATA_ROOT=/mnt/storage/data
# App databases and API keys. Deliberately OUTSIDE the git repo.
CONFIG_ROOT=/home/YOUR_USER/homelab-media-stack-data/config

# ---- Network ----
LAN_CIDR=192.168.1.0/24
# Prowlarr's fixed address on the docker "arr" network (172.18.0.0/16); see docker-compose.yml.
PROWLARR_IP=172.18.0.200
QBIT_PORT=8080
# Optional modules on top of the core (VPN, downloaders, Prowlarr, Radarr, Sonarr, Bazarr, Seerr,
# Jellyfin): music, games, monitoring, stats, dashboards, plex. * turns every one on; a list such as
# music,monitoring picks some. Docker Compose reads it too, so `docker compose` commands follow it.
COMPOSE_PROFILES=*
# CPU cores Jellyfin, Plex and Byparr may each use; keep it below the machine's core count.
MEDIA_CPUS=3
# Hardware transcoding on Intel/AMD graphics (x86 only; a Pi 5 has no encoder). Uncomment both,
# then run configure-jellyfin-plugins.py. HWACCEL: vaapi (Intel or AMD) or qsv (Intel).
#COMPOSE_FILE=docker-compose.yml:compose.gpu.yml
#HWACCEL=vaapi

# ---- Proton VPN ----
# account.protonvpn.com -> Downloads -> WireGuard configuration
# Generate a dedicated Netherlands P2P config with NAT-PMP on and Moderate NAT off.
# Copy PrivateKey here; install its IPv4 endpoint config as described in README's VPN section.
WIREGUARD_PRIVATE_KEY=replace-me
# Allowed exit countries checked by health-check; custom mode does not select servers by country.
VPN_COUNTRIES=Netherlands

# ---- Plex ----
# Get a fresh token from https://plex.tv/claim (expires in ~4 minutes).
# Only needed for the very first run; can be blank afterwards.
PLEX_CLAIM=

# ---- Recyclarr ----
# Read from the running apps: Settings -> General -> API Key in each.
RADARR_API_KEY=
SONARR_API_KEY=

# ---- Jellyfin admin ----
JELLYFIN_USER=admin
JELLYFIN_PASSWORD=
# The name apps show for the server (defaults to "Home Media").
JELLYFIN_SERVER_NAME="Home Media"

# ---- Dashboard / monitoring ----
# Homepage refuses requests whose Host header is not listed here.
HOMEPAGE_ALLOWED_HOSTS=hostname:3000,lan-ip:3000,tailscale-ip:3000,localhost:3000
PROWLARR_API_KEY=
BAZARR_API_KEY=
SEERR_API_KEY=
JELLYFIN_API_KEY=
GRAFANA_USER=admin
GRAFANA_PASSWORD=
JELLYSTAT_DB_USER=jellystat
JELLYSTAT_DB_PASSWORD=
JELLYSTAT_JWT_SECRET=

# Jellyfin API key dedicated to Jellystat
JELLYSTAT_JELLYFIN_API_KEY=

# ---- Glance (:3005) ----
# Both filled in by configure-glance.py: a Jellystat key named "glance", and
# the key ChangeDetection.io generates on first start.
JELLYSTAT_API_KEY=
CHANGEDETECTION_API_KEY=
# YouTube subscriptions for Glance's video rows (scripts/sync-youtube.py): an
# OAuth client of type "TVs and Limited Input devices" with the YouTube Data API
# enabled. The refresh token is filled in by `sync-youtube.py --login`.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Spotify app from developer.spotify.com (needs Premium), for Spotify in Needle.
# NEEDLE_PUBLIC_URL is Needle's Tailscale Serve address, e.g.
# https://<hostname>.<tailnet>.ts.net:4535, and <NEEDLE_PUBLIC_URL>/api/spotify/callback
# is the redirect URI registered in the Spotify app.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
NEEDLE_PUBLIC_URL=
# Needle's image. Default ghcr.io/bugrauluyurt/needle:1 follows every 1.x release; set
# needle:local to run your own build (docker build -t needle:local <needle checkout>).
NEEDLE_IMAGE=

# restic backup encryption password (scripts/backup-config)
RESTIC_PASSWORD=
# Optional offsite copy of every backup, e.g. s3:s3.eu-central-003.backblazeb2.com/<bucket>/arr
# or b2:<bucket>:arr. Uses RESTIC_PASSWORD; the backend's own credentials go
# alongside (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or B2_ACCOUNT_ID / B2_ACCOUNT_KEY).
RESTIC_OFFSITE_REPO=

# Cleanuparr web login (user: admin)
CLEANUPARR_PASSWORD=

# Questarr web login (user: admin)
QUESTARR_PASSWORD=
# Game metadata. Register an app at https://dev.twitch.tv/console
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# ---- Music ----
# Soulseek account. It doesn't exist anywhere yet: slskd registers it on
# first login, so pick any unique username and a random password.
SOULSEEK_USER=
SOULSEEK_PASS=
# slskd web UI (user admin) and the API key Lidarr and Needle (single songs) use.
# Both random strings.
SLSKD_PASSWORD=
SLSKD_API_KEY=
# Navidrome admin, created by configure-lidarr.py
NAVIDROME_USER=admin
NAVIDROME_PASS=
# From Lidarr -> Settings -> General, for the Homepage widget
LIDARR_API_KEY=

# ---- Notifications ----
# Push notifications through ntfy (free iPhone/Android app). The topic is a
# channel anyone who knows the name can read, so make it long and random.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# ---- Uptime Kuma (status page and down-alerts, :3003) ----
# Admin login, created by configure-uptime-kuma.py. Any password works, even one
# Kuma itself calls too weak: the script writes it as a hash.
UPTIME_KUMA_USER=admin
UPTIME_KUMA_PASSWORD=

# ---- Dozzle (:8888) and JellyDash (:3004) ----
# Logins, applied by configure-dozzle.py and configure-jellydash.py. JellyDash's
# own 8-character minimum doesn't apply: the script writes the password as a hash.
DOZZLE_USER=admin
DOZZLE_PASSWORD=
JELLYDASH_USER=admin
JELLYDASH_PASSWORD=
# Created in Jellyfin and filled in by configure-jellydash.py.
JELLYDASH_JELLYFIN_API_KEY=

# ---- Games download page, SFTPGo (:8090) ----
# Your login, applied by configure-sftpgo.py. Viewers get theirs from add-viewer.py.
# Every account is read-only, so yours grants nothing theirs doesn't.
GAMES_USER=admin
GAMES_PASSWORD=
# SFTPGo's admin, used only by the scripts (REST API, allowed from the Pi alone).
# Created on first start; use a long random value, e.g. `openssl rand -base64 24`.
SFTPGO_ADMIN_USER=gamesadmin
SFTPGO_ADMIN_PASSWORD=

# ---- Usenet (optional; preferred over torrents when set) ----
# Provider account (e.g. Newshosting) and indexer API key (e.g. NZBgeek).
# If the password contains a $, wrap the value in single quotes.
USENET_HOST=
USENET_PORT=563
USENET_USER=
USENET_PASS=
USENET_CONNECTIONS=20
NZBGEEK_API_KEY=
# Semi-private French trackers (French TV the English sites don't carry). Free
# sign-up at draupnirr.xyz / tr4ker.net; the API key is on your profile page.
# add-indexers.py adds each one once its key is set.
DRAUPNIRR_API_KEY=
TR4KER_API_KEY=
# SABnzbd web login (the apps use its API key instead).
SABNZBD_USER=admin
SABNZBD_PASSWORD=
# Filled in by configure-sabnzbd.py.
SABNZBD_API_KEY=

# ---- Subtitle providers (Bazarr) - each is enabled only when filled ----
# opensubtitles.com account (free tier is enough). The biggest source by far.
OPENSUBTITLES_USER=
OPENSUBTITLES_PASS=
# subsource.net -> profile -> API key
SUBSOURCE_API_KEY=

# ---- Jellyfin Enhanced extras (optional) ----
# themoviedb.org -> Settings -> API (v3 key): reviews, "where to stream"
TMDB_API_KEY=
# mdblist.com -> Preferences -> API: IMDb / Rotten Tomatoes / Metacritic ratings on posters
MDBLIST_API_KEY=
