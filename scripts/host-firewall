#!/usr/bin/python3
"""Host firewall for IPv4 and IPv6. Run as root.

Runs: arr-firewall.service at boot and arr-firewall.timer every 15 minutes; stack-health runs
  host-firewall home-ports; by hand with sudo.
Changes: iptables and ip6tables chains.
Idempotent: yes.

From the home network the server answers only on Jellyfin, Seerr and the games page (plus
DHCP, mDNS and Tailscale); SSH and every other port answer only on the tailnet.

  firewall         apply (only rebuilds when the wanted rules changed)
  firewall off      remove every rule this script added
  firewall status   show the rules
  firewall home-ports  the ports open to the home network (stack-health reads this)
"""
import hashlib
import ipaddress
import json
import shutil
import subprocess
import sys

sys.dont_write_bytecode = True
from stack_env import ENV  # noqa: E402

CHAINS = {"ARR-IN": "INPUT", "ARR-OUT": "OUTPUT", "ARR-FWD": "DOCKER-USER"}
TRUSTED_IFACES = ["lo", "tailscale0", "docker0", "br+"]
HOME_APPS = ["8096", "5055", "8090"]
TAILSCALE_PORT = "41641"
OPEN_UDP_PORTS = [TAILSCALE_PORT, "5353"]
ESTABLISHED = "-m conntrack --ctstate ESTABLISHED,RELATED -j RETURN"


def run(*args, check=True, timeout=None):
    return subprocess.run(args, capture_output=True, text=True, check=check, timeout=timeout)


def lan_ifaces():
    return [i["ifname"] for i in json.loads(run("ip", "-j", "link", "show").stdout)
            if i["ifname"] not in ("lo", "tailscale0", "docker0") and not i["ifname"].startswith(("br-", "veth"))
            and "master" not in i]


def default_gateway(family):
    routes = json.loads(run("ip", "-j", family, "route", "show", "default").stdout)
    return routes[0]["gateway"] if routes else None


def ipv6_lan_prefixes():
    nets = set()

    for iface in json.loads(run("ip", "-j", "-6", "addr", "show", "scope", "global").stdout):
        if iface["ifname"] in lan_ifaces():
            for a in (a for a in iface["addr_info"] if "local" in a):
                nets.add(ipaddress.ip_network(f"{a['local']}/{min(a['prefixlen'], 64)}", strict=False))

    return sorted(str(n) for n in nets)


def rules_v4():
    lan = ipaddress.ip_network(ENV["LAN_CIDR"])
    gateways = [g for g in [default_gateway("-4")] if g]

    return {
        "ARR-IN": [*(f"-i {i} -j RETURN" for i in TRUSTED_IFACES), ESTABLISHED, "-p icmp -j RETURN",
                   *home_port_rules("--dport", [str(lan)]),
                   *(f"-p udp --dport {port} -j RETURN" for port in OPEN_UDP_PORTS),
                   "-p udp --dport 68 -j RETURN", "-j DROP"],
        "ARR-OUT": ["-o lo -j RETURN", ESTABLISHED, f"! -d {lan} -j RETURN", *(f"-d {g} -j RETURN" for g in gateways),
                    f"-d {lan.broadcast_address} -j RETURN", f"-p udp --sport {TAILSCALE_PORT} -j RETURN",
                    "-j REJECT"],
        "ARR-FWD": forward_rules([str(lan)], gateways),
    }


def rules_v6():
    prefixes = ipv6_lan_prefixes()
    router = default_gateway("-6")
    router_ids = [router] if router else []

    if router:
        suffix = int(ipaddress.ip_address(router)) & (2**64 - 1)
        router_ids += [str(ipaddress.ip_network(p)[suffix]) for p in prefixes]

    return {
        "ARR-IN": [*(f"-i {i} -j RETURN" for i in TRUSTED_IFACES), ESTABLISHED, "-p ipv6-icmp -j RETURN",
                   *home_port_rules("--dport", ["fe80::/10", *prefixes]),
                   *(f"-p udp --dport {port} -j RETURN" for port in OPEN_UDP_PORTS),
                   "-s fe80::/10 -p udp --dport 546 -j RETURN", "-j DROP"],
        "ARR-OUT": ["-o lo -j RETURN", ESTABLISHED, "-p ipv6-icmp -j RETURN", "-d ff00::/8 -j RETURN",
                    *(f"-d {r} -j RETURN" for r in router_ids), f"-p udp --sport {TAILSCALE_PORT} -j RETURN",
                    *(f"-d {p} -j REJECT" for p in ["fe80::/10", *prefixes])],
        "ARR-FWD": forward_rules(["fe80::/10", *prefixes], router_ids),
    }


def forward_rules(lan_nets, allowed):
    containers = ["docker0", "br+"]

    return [ESTABLISHED, "-i tailscale0 -j RETURN", *(f"-d {a} -j RETURN" for a in allowed),
            *(f"-i {c} -d {n} -j REJECT" for c in containers for n in lan_nets),
            *(f"-i {c} -j RETURN" for c in containers),
            *home_port_rules("-m conntrack --ctorigdstport", lan_nets), "-j DROP"]


# Source-restricted so a global IPv6 address or a router port forward never exposes home apps.
def home_port_rules(port_match, lan_nets):
    return [f"-s {net} -p tcp {port_match} {port} -j RETURN" for net in lan_nets for port in HOME_APPS]


def tag(rules):
    return "arr-fw " + hashlib.sha1(json.dumps(rules, sort_keys=True).encode()).hexdigest()[:12]


def apply(tool, rules):
    stamp = tag(rules)
    current = run(tool, "-w", "-S", "ARR-IN", check=False).stdout

    if stamp not in current:
        for chain, lines in rules.items():
            run(tool, "-w", "-N", chain, check=False)
            run(tool, "-w", "-F", chain)
            for line in lines:
                run(tool, "-w", "-A", chain, *line.split())

        run(tool, "-w", "-I", "ARR-IN", "1", "-m", "comment", "--comment", stamp)
        print(f"  + {tool}: rules rebuilt ({stamp})")
    else:
        print(f"  = {tool}: rules current ({stamp})")

    for chain, parent in CHAINS.items():
        run(tool, "-w", "-N", parent, check=False)
        if run(tool, "-w", "-C", parent, "-j", chain, check=False).returncode:
            run(tool, "-w", "-I", parent, "1", "-j", chain)
            print(f"  + {tool}: {parent} -> {chain}")


def remove(tool):
    for chain, parent in CHAINS.items():
        while run(tool, "-w", "-D", parent, "-j", chain, check=False).returncode == 0:
            pass

        run(tool, "-w", "-F", chain, check=False)
        run(tool, "-w", "-X", chain, check=False)

    print(f"  - {tool}: rules removed")


def firewall_conflicts():
    active_firewalls = []

    if shutil.which("ufw") and "Status: active" in run("ufw", "status", check=False).stdout:
        active_firewalls.append("ufw")
    if run("systemctl", "is-active", "-q", "firewalld", check=False).returncode == 0:
        active_firewalls.append("firewalld")

    conflicts = [f"{name} is active and would drop what these rules allow; disable it (systemctl disable --now {name})"
                 for name in active_firewalls]

    try:
        docker_backend = run("docker", "info", "--format", "{{.FirewallBackend.Driver}}", check=False, timeout=30).stdout.strip()
    except subprocess.TimeoutExpired:
        docker_backend = ""

    if docker_backend == "nftables":
        conflicts.append("Docker's nftables firewall backend ignores DOCKER-USER, so published ports would stay open")

    return conflicts


if __name__ == "__main__":
    action = sys.argv[1] if len(sys.argv) > 1 else "apply"

    if action not in ("off", "home-ports", "status") and (conflicts := firewall_conflicts()):
        sys.exit("firewall not applied:\n  " + "\n  ".join(conflicts))

    for tool, build in (("iptables", rules_v4), ("ip6tables", rules_v6)):
        if action == "off":
            remove(tool)
        elif action == "home-ports":
            print(" ".join(sorted(HOME_APPS, key=int)))
            break
        elif action == "status":
            for chain in CHAINS:
                print(run(tool, "-w", "-S", chain, check=False).stdout, end="")
        else:
            apply(tool, build())
