#!/usr/bin/env python3
"""Test every indexer in Prowlarr and report which are actually working.

Run by hand: Prowlarr already tracks failures and disables failing indexers itself;
this surfaces that on demand.
"""
import json
import urllib.error
import urllib.request

from stack_env import arr_key

BASE = "http://127.0.0.1:9696"

KEY = arr_key("prowlarr")


def call(path, body=None, method=None, timeout=180):
    data = json.dumps(body).encode() if body is not None else None
    r = urllib.request.Request(BASE + path, data=data,
                               method=method or ("POST" if data else "GET"),
                               headers={"X-Api-Key": KEY,
                                        "Content-Type": "application/json"})

    try:
        raw = urllib.request.urlopen(r, timeout=timeout).read()
        return json.loads(raw) if raw else None
    except urllib.error.HTTPError as e:
        return {"__error": e.read().decode()[:200]}


indexers = call("/api/v1/indexer") or []
stats = {s["indexerId"]: s for s in (call("/api/v1/indexerstats") or {}).get("indexers", [])}

print(f"{'INDEXER':<18} {'ENABLED':<8} {'TEST':<8} {'QUERIES':<9} {'FAILED':<7} {'MS':<6}")
print("-" * 62)

working = broken = 0
for idx in sorted(indexers, key=lambda i: i["name"].lower()):
    res = call("/api/v1/indexer/test", idx)
    ok = not (isinstance(res, dict) and "__error" in res)

    st = stats.get(idx["id"], {})
    q = st.get("numberOfQueries", 0)
    f = st.get("numberOfFailedQueries", 0) + st.get("numberOfFailedGrabs", 0)
    ms = st.get("averageResponseTime", 0)

    print(f"{idx['name']:<18} {str(idx['enable']):<8} {'PASS' if ok else 'FAIL':<8} "
          f"{q:<9} {f:<7} {ms:<6}")

    if ok:
        working += 1
    else:
        broken += 1
        err = res["__error"]

        try:
            msgs = {e.get("errorMessage") for e in json.loads(err)}
            err = "; ".join(m for m in msgs if m)
        except Exception:
            pass

        print(f"{'':<18} └─ {err[:90]}")

print("-" * 62)
print(f"  {working} working, {broken} failing")

health = call("/api/v1/health") or []
if health:
    print("\n  Prowlarr health warnings:")
    for h in health:
        print(f"    [{h.get('type')}] {h.get('message')[:100]}")
