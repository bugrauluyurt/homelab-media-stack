#!/usr/bin/env bash
# Bring the stack up (arr-stack.service's ExecStart). A VPN-only failure must not fail
# the unit, or systemd's BindsTo drive-lifecycle binding stops working.
# Runs: arr-stack.service, at boot and whenever the media drive mounts. Start it with sudo systemctl
#   start arr-stack.service rather than directly.
# Changes: creates and starts containers; may recreate qBittorrent and slskd and restart Dozzle;
#   qBittorrent settings through vpn-port-sync.
# Idempotent: yes.

set -uo pipefail
. "$(dirname "$0")/stack-env.sh"
cd "$REPO" || exit 1

mountpoint -q "$STORAGE_MOUNT" || { echo "FATAL: $STORAGE_MOUNT not mounted; refusing to start."; exit 1; }

# Docker creates a missing bind-mount folder as root, which services running as PUID can't write,
# so every folder under the app-data root is created here first, as the stack user.
docker compose config --format json | python3 -c '
import json, os, sys
data_root = os.path.dirname(os.environ["CONFIG_ROOT"].rstrip("/")) + "/"
for service in json.load(sys.stdin)["services"].values():
    for volume in service.get("volumes", []):
        if volume.get("type") == "bind" and volume["source"].startswith(data_root):
            print(volume["source"])' | xargs -r mkdir -p

# Seed any missing YouTube list from the pinned channels, and an empty video row until the first sync.
"$REPO/scripts/youtube-sync.py" --offline

docker compose up -d --remove-orphans
rc=$?

# The VPN pair is allowed to be down; the library services are not.
core="prowlarr radarr sonarr lidarr bazarr seerr plex jellyfin navidrome"
missing=""
for s in $core; do
  service_enabled "$s" || continue
  docker compose ps --status running --format '{{.Service}}' | grep -qx "$s" || missing="$missing $s"
done

if [ -n "$missing" ]; then
  echo "FATAL: core services not running:$missing"
  exit 1
fi

# After a boot qBittorrent starts on a stale forwarded port; sync now rather than wait for the timer.
if docker compose ps --status running --format '{{.Service}}' | grep -qx gluetun; then
  if wait_gluetun_healthy 120; then
    "$REPO/scripts/vpn-port-sync" || echo "WARN: port sync failed; the timer will retry."
  else
    echo "WARN: VPN is not healthy; the port-sync timer will restore downloaders after recovery."
  fi
fi

# Dozzle lists containers once at start; if Docker was too busy to answer, it shows no stats for them.
if docker compose ps --status running --format '{{.Service}}' | grep -qx dozzle &&
   docker logs --since "$(docker inspect -f '{{.State.StartedAt}}' dozzle)" dozzle 2>&1 | grep -q "failed to list containers"; then
  echo "WARN: Dozzle started before Docker could list containers; restarting it."
  docker compose restart dozzle
fi

if [ "$rc" -ne 0 ]; then
  echo "WARN: compose exited $rc but all core services are up (VPN likely still connecting)."
fi
exit 0
