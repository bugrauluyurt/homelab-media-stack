#!/usr/bin/env bash
# One-shot status of the whole stack. Safe to run any time, but not read-only:
# it writes a hardlink test file on the drive and starts throwaway curl containers.
# --notify: also push the failures to ntfy (the arr-health timer uses this).

. "$(dirname "$0")/stack-env.sh"
cd "$REPO" || exit 1

pass=0; fail=0; failed=()
chk() { if eval "$2" >/dev/null 2>&1; then printf "  \033[32mOK\033[0m   %s\n" "$1"; pass=$((pass+1));
        else printf "  \033[31mFAIL\033[0m %s\n" "$1"; fail=$((fail+1)); failed+=("$1"); fi; }

# chk_if SERVICE LABEL COMMAND: a chk that runs only while SERVICE's module is on (COMPOSE_PROFILES).
chk_if() { service_enabled "$1" && chk "$2" "$3"; }

echo "STORAGE"
chk "$STORAGE_MOUNT is mounted"           "mountpoint -q '$STORAGE_MOUNT'"
# Hardlinks and the drive power binding both need the data inside the media mount.
chk "DATA_ROOT is on the media mount"    "[ \"\$(findmnt -no TARGET -T '$DATA_ROOT')\" = '$STORAGE_MOUNT' ]"
chk "media tree present"                 "test -d '$DATA_ROOT/media/movies' -a -d '$DATA_ROOT/media/tv'"
chk "hardlinks work across data/"        "touch '$DATA_ROOT/torrents/movies/.hc' && ln -f '$DATA_ROOT/torrents/movies/.hc' '$DATA_ROOT/media/movies/.hc'"
rm -f "$DATA_ROOT/torrents/movies/.hc" "$DATA_ROOT/media/movies/.hc"

disk_below() { [ "$(df --output=pcent "$1" | tail -1 | tr -dc 0-9)" -lt "$2" ]; }
chk "media drive under 90% full"        "disk_below '$STORAGE_MOUNT' 90"
chk "system disk under 90% full"         "disk_below / 90"

# smartctl's JSON reads the same for SATA, NVMe and USB drives (a USB bridge needs -d sat); any bad sector means failure is near.
drive_smart() {
  local disk device_type=()
  disk=$(disk_of_mount "$STORAGE_MOUNT")
  [ "$(lsblk -dno TRAN "$disk")" = usb ] && device_type=(-d sat)

  sudo smartctl -j -a "${device_type[@]}" "$disk" | python3 -c '
import json, sys
smart = json.load(sys.stdin)
ata = {attribute["name"]: attribute["raw"]["value"] for attribute in smart.get("ata_smart_attributes", {}).get("table", [])}
bad_sectors = sum(ata.get(name, 0) for name in ("Reallocated_Sector_Ct", "Current_Pending_Sector", "Offline_Uncorrectable"))
bad_sectors += smart.get("nvme_smart_health_information_log", {}).get("media_errors", 0)
passed = {"health": smart["smart_status"]["passed"], "sectors": bad_sectors == 0, "temperature": smart["temperature"]["current"] < 55}
sys.exit(not passed[sys.argv[1]])' "$1"
}
chk "media drive SMART health passed"    "drive_smart health"
chk "media drive: no bad sectors"        "drive_smart sectors"
chk "media drive under 55C"              "drive_smart temperature"

if command -v vcgencmd >/dev/null; then
  echo "HARDWARE"
  # Low four bits of get_throttled: current under-voltage, frequency cap, throttling, soft temperature limit.
  chk "not throttled or under-voltage"   "[ \$(( \$(vcgencmd get_throttled | cut -d= -f2) & 0xF )) -eq 0 ]"
  chk "SoC under 80C"                    "[ \$(vcgencmd measure_temp | grep -oP '[0-9]+' | head -1) -lt 80 ]"
fi

echo "SYSTEMD"
chk "arr-stack.service enabled"          "systemctl is-enabled -q arr-stack.service"
chk "arr-stack.service active"           "systemctl is-active -q arr-stack.service"
chk "service bound to the mount"         "systemctl show arr-stack.service -p BindsTo --value | grep -qF \"\$(systemd-escape --path --suffix=mount '$STORAGE_MOUNT')\""
for t in arr-backup arr-updates arr-port-sync arr-health arr-watch arr-throttle arr-youtube; do
  [ "$t" = arr-youtube ] && ! service_enabled glance && continue
  chk "$t.timer enabled"               "systemctl is-enabled -q $t.timer"
done
chk "no failed systemd units"            "[ -z \"\$(systemctl --failed --no-legend)\" ]"

chk "memory limits supported by kernel" "grep -qw memory /sys/fs/cgroup/cgroup.controllers"
# A container created while the memory cgroup was unavailable silently loses its
# mem_limit, and compose won't recreate it because its config is unchanged.
chk "every container has a memory limit" "! docker compose ps -q | xargs docker inspect -f '{{.HostConfig.Memory}}' | grep -qx 0"

chk "$HOST_NAME.local -> a LAN address" "getent hosts $HOST_NAME.local | python3 -c 'import ipaddress, os, sys; sys.exit(ipaddress.ip_address(sys.stdin.read().split()[0]) not in ipaddress.ip_network(os.environ[\"LAN_CIDR\"]))'"

echo "SECURITY"
chk "firewall loaded (IPv4 host + Docker)"  "sudo iptables -C INPUT -j ARR-IN && sudo iptables -C OUTPUT -j ARR-OUT && sudo iptables -C DOCKER-USER -j ARR-FWD"
chk "firewall loaded (IPv6 host + Docker)"  "sudo ip6tables -C INPUT -j ARR-IN && sudo ip6tables -C OUTPUT -j ARR-OUT && sudo ip6tables -C DOCKER-USER -j ARR-FWD"
FIREWALL_EVERY=$(sed -n 's/^OnUnitActiveSec=//p' "$REPO/systemd/arr-firewall.timer")
chk "firewall re-applied at boot + every $FIREWALL_EVERY" "systemctl is-enabled -q arr-firewall.service && systemctl is-enabled -q arr-firewall.timer"

# Exactly the firewall's HOME_APPS are open to the home network, only to home sources; all else drops.
HOME_PORTS=$("$REPO/scripts/firewall" home-ports)
home_ports_ok() {
  local ipt
  for ipt in iptables ip6tables; do
    test "$(sudo $ipt -S ARR-FWD | grep -oP 'ctorigdstport \K[0-9]+' | sort -nu | xargs)" = "$HOME_PORTS" &&
      sudo $ipt -S ARR-FWD | tail -1 | grep -qx -- '-A ARR-FWD -j DROP' &&
      ! { sudo $ipt -S ARR-IN; sudo $ipt -S ARR-FWD; } | grep -E -- "(dport|ctorigdstport) (${HOME_PORTS// /|}) " | grep -qv -- ' -s ' || return 1
  done
}
chk "home network: only ports $HOME_PORTS, only from home" "home_ports_ok"
chk "ssh: keys only"                         "sudo sshd -T | grep -qx 'passwordauthentication no'"
chk "ssh: closed to the home network"        "! sudo iptables -S ARR-IN | grep -q 'dport 22 ' && ! sudo ip6tables -S ARR-IN | grep -q 'dport 22 '"
KEYS="$(getent passwd "$STACK_USER" | cut -d: -f6)/.ssh/authorized_keys"
chk "ssh: every key pinned to its sources"   "test -s '$KEYS' && ! grep -vE '^(#|$)' '$KEYS' | grep -qv '^from=\"'"
chk "rpcbind off"                            "! systemctl is-active -q rpcbind.socket rpcbind.service"
chk_if sftpgo "games page: no login, no files"        "test \"\$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 'http://127.0.0.1:8090/api/v2/user/dirs?path=/')\" = 401"
chk_if sftpgo "games SFTP answering (read-only accounts)" "timeout 8 bash -c 'exec 3<>/dev/tcp/127.0.0.1/2022; head -c 16 <&3' | grep -q SFTPGo"
chk_if sftpgo "games page: admin refused off the Pi"   "test \"\$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 -u \"\$SFTPGO_ADMIN_USER:\$SFTPGO_ADMIN_PASSWORD\" http://$TAILSCALE_IP:8090/api/v2/token)\" = 401"

# Any whitelisted range overlapping the LAN (e.g. 192.168.0.0/16) counts, not just LAN_CIDR itself.
lan_must_log_in() {
  qbit_prefs | python3 -c '
import ipaddress, json, os, sys
p = json.load(sys.stdin)
lan = ipaddress.ip_network(os.environ["LAN_CIDR"], strict=False)
nets = p["bypass_auth_subnet_whitelist"].replace(",", "\n").split() if p["bypass_auth_subnet_whitelist_enabled"] else []
sys.exit(any(lan.overlaps(ipaddress.ip_network(n, strict=False)) for n in nets))'
}
chk "qbittorrent: home network must log in"  "lan_must_log_in"
chk "qbittorrent: CSRF and Host checks on"   "qbit_prefs | python3 -c 'import json, sys; p = json.load(sys.stdin); sys.exit(not (p[\"web_ui_csrf_protection_enabled\"] and p[\"web_ui_host_header_validation_enabled\"] and \"*\" != p[\"web_ui_domain_list\"]))'"
chk "qbittorrent: cross-site requests refused" "test \"\$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 -H 'Origin: http://evil.example' -d 'json={}' http://127.0.0.1:$QBIT_PORT/api/v2/app/setPreferences)\" = 401"

echo "BACKUPS"
chk "backup timer enabled"            "systemctl is-enabled -q arr-backup.timer"
# The drive is powered by hand, so the checks that need it pass while it's off.
BACKUP_MAX_AGE_H=48
chk "last backup under ${BACKUP_MAX_AGE_H}h old" "! mountpoint -q '$STORAGE_MOUNT' || [ \$(( \$(date +%s) - \$(date -d \"\$(cat /var/lib/arr-backup/last-success 2>/dev/null || echo 1970-01-01)\" +%s) )) -lt $((BACKUP_MAX_AGE_H * 3600)) ]"
chk "backup key copy on the media drive" "! mountpoint -q '$STORAGE_MOUNT' || sudo test -s '$STORAGE_MOUNT/backups/RESTIC_PASSWORD'"
chk "backup copy on the NVMe"          "sudo test -s /var/backups/arr-stack/restic/config"

echo "SERVICES"
for s in "prowlarr 9696" "radarr 7878" "sonarr 8989" "lidarr 8686" "bazarr 6767" "seerr 5055" "questarr 5000/api/health" "jellyfin 8096" "plex 32400" "navidrome 4533/ping" "needle 4535/api/health" "slskd 5030/health" "uptime-kuma 3003" "dozzle 8888/healthcheck" "jellydash 3004/healthz.php" "sabnzbd 8085" "sftpgo 8090/healthz" "scrutiny 3006/api/health" "changedetection 3007"; do
  set -- $s
  service_enabled "$1" || continue
  chk "$1 responding on $2" "curl -sf -o /dev/null --max-time 8 http://127.0.0.1:$2"
done

# A Jellyfin update can disable plugins built for an older version without anything else failing.
jellyfin_plugins_ok() {
  curl -sf --max-time 10 -H "Authorization: MediaBrowser Token=\"$JELLYFIN_API_KEY\"" http://127.0.0.1:8096/Plugins \
    | python3 -c 'import json, sys; bad = [p["Name"] + ":" + p["Status"] for p in json.load(sys.stdin) if p["Status"] != "Active"]; print(", ".join(bad)); sys.exit(1 if bad else 0)'
}
chk "jellyfin plugins all active"       "jellyfin_plugins_ok"

arr_health_ok() {
  curl -sf --max-time 10 -H "X-Api-Key: $3" "http://127.0.0.1:$2/api/$4/health" \
    | python3 -c 'import json, sys; sys.exit(any(h["type"] == "error" for h in json.load(sys.stdin)))'
}
for s in "radarr 7878 RADARR_API_KEY v3" "sonarr 8989 SONARR_API_KEY v3" "lidarr 8686 LIDARR_API_KEY v1" "prowlarr 9696 PROWLARR_API_KEY v1"; do
  set -- $s
  service_enabled "$1" || continue
  chk "$1 reports no errors" "arr_health_ok $1 $2 '${!3}' $4"
done

echo "MONITORING"
CURL_IMAGE=curlimages/curl:8.22.0
# Homepage's status dots go through the socket proxy; if it breaks, every tile shows "API error".
chk_if homepage "homepage sees container status"   "curl -s --max-time 15 -H 'Host: localhost:3000' 'http://127.0.0.1:3000/api/docker/statuses?server=my-docker' | grep -q '\"status\":\"running\"'"
chk "socket proxy refuses writes"      "test \"\$(docker run --rm --network arr $CURL_IMAGE -s -o /dev/null -w '%{http_code}' --max-time 10 -X POST http://socket-proxy:2375/containers/jellyfin/stop)\" = 403"
chk "socket proxy allows log reads (Dozzle)" "test \"\$(docker run --rm --network arr $CURL_IMAGE -s -o /dev/null -w '%{http_code}' --max-time 10 'http://socket-proxy:2375/containers/jellyfin/logs?stdout=1&tail=1')\" = 200"
chk_if homepage "homepage holds no raw socket"     "! docker exec homepage test -e /var/run/docker.sock"
chk_if glance "glance sees container status"     "curl -s --max-time 30 http://127.0.0.1:3005/api/pages/lab/content/ | grep -q docker-container-status-icon"
# Only once signed in (sync-youtube.py --login); until then the pinned lists are used.
chk_if glance "youtube channel lists synced in 14 days" "[ -z \"\${YOUTUBE_REFRESH_TOKEN:-}\" ] || [ -n \"\$(find '$STATE_ROOT/metrics/youtube.prom' -mtime -14 2>/dev/null)\" ]"
chk_if glance "glance holds no raw socket"       "! docker exec glance test -e /var/run/docker.sock"
for s in "homepage 3000" "glance 3005/api/healthz" "grafana 3001/api/health" "jellystat 3002" "prometheus 9090/-/ready"; do
  set -- $s
  service_enabled "$1" || continue
  chk "$1 responding" "curl -sf -o /dev/null --max-time 8 http://127.0.0.1:$2"
done
# Published on the Docker network only.
for s in "scraparr 7100/metrics" "node-exporter 9100/metrics"; do
  set -- $s
  service_enabled "$1" || continue
  chk "$1 responding" "docker exec $1 wget -q -O /dev/null -T 8 http://127.0.0.1:$2"
done
chk_if prometheus "prometheus has backup and update metrics" "curl -s --max-time 8 'http://127.0.0.1:9090/api/v1/query?query=%7B__name__%3D~%22arr_backup_last_success_timestamp_seconds%7Carr_image_updates_available%22%7D' | python3 -c 'import json,sys; sys.exit(len(json.load(sys.stdin)[\"data\"][\"result\"]) < 2)'"
chk_if prometheus "prometheus: all targets up" "curl -s --max-time 8 http://127.0.0.1:9090/api/v1/targets | python3 -c 'import json,sys; t=json.load(sys.stdin)[\"data\"][\"activeTargets\"]; sys.exit(0 if t and all(x[\"health\"]==\"up\" for x in t) else 1)'"


echo "CLEANUP & INTROS"
chk "cleanuparr healthy"              "test \"\$(docker inspect -f '{{.State.Health.Status}}' cleanuparr 2>/dev/null)\" = healthy"
chk "cleanuparr live (not dry-run)"   "./scripts/cleanuparr-state | grep -q '^live'"
# The download cleaner removes seeding downloads, which cost no disk here (hardlinks), so it stays off.
chk "cleanuparr download cleaner off" "./scripts/cleanuparr-state | grep -q 'downloadcleaner=off'"
chk "cleanuparr ignores game downloads" "./scripts/cleanuparr-state | grep -q 'ignored=.*games'"
chk "cleanuparr has no media mount"   "! docker inspect -f '{{range .Mounts}}{{.Destination}} {{end}}' cleanuparr | grep -qw /data"
chk "intro skipper plugin removed"    "! docker exec jellyfin sh -c 'ls /config/data/plugins' | grep -qi 'Intro Skipper'"

echo "INDEXERS"
chk "prowlarr has working indexers"      "test \$(./scripts/check-indexers 2>/dev/null | grep -c ' PASS ') -ge 1"
# Byparr's /health launches a real browser (15 to 20s), so read its container healthcheck instead.
chk "byparr (cloudflare solver) healthy" "test \"\$(docker inspect -f '{{.State.Health.Status}}' byparr 2>/dev/null)\" = healthy"

echo "VPN"
chk "gluetun container running"          "docker compose ps --status running --format '{{.Service}}' | grep -qx gluetun"

vpn_country_ok() {
  local c
  c=$(docker logs gluetun 2>&1 | grep -oP 'Public IP address is \S+ \(\K[^,]+' | tail -1)
  [ -n "$c" ] && [ "$c" != "United States" ] && tr ',' '\n' <<< "$VPN_COUNTRIES" | sed 's/^ *//; s/ *$//' | grep -qxF "$c"
}
chk "VPN exits in VPN_COUNTRIES, never the US" "vpn_country_ok"
chk "qbittorrent running"                "docker compose ps --status running --format '{{.Service}}' | grep -qx qbittorrent"
chk "qbittorrent WebUI answering"        "curl -sf -o /dev/null --max-time 8 http://127.0.0.1:$QBIT_PORT"
chk "radarr can reach qbittorrent"       "docker exec radarr curl -sf -o /dev/null --max-time 8 http://gluetun:$QBIT_PORT/api/v2/app/version"
chk "radarr can reach sabnzbd"           "docker exec radarr curl -sf -o /dev/null --max-time 8 http://sabnzbd:8080/api?mode=version"
chk "sabnzbd trusts the tailnet (phones)" "grep -q '^local_ranges = .*100.64.0.0/10' $CONFIG_ROOT/sabnzbd/sabnzbd.ini"
chk_if slskd "lidarr can reach slskd"             "docker exec lidarr curl -sf -o /dev/null --max-time 8 http://gluetun:5030/health"
chk_if slskd "slskd logged in to soulseek"        "docker exec lidarr curl -sf -H 'X-API-Key: $SLSKD_API_KEY' http://gluetun:5030/api/v0/application | grep -q LoggedIn"
chk_if needle "needle can reach slskd"             "docker exec needle wget -qO /dev/null -T 8 --header 'X-API-Key: $SLSKD_API_KEY' http://gluetun:5030/api/v0/application"
chk_if needle "needle can write singles"           "docker exec needle sh -c 'touch /singles/.hc && rm /singles/.hc'"

qbit_on_tunnel() {
  local ip port
  ip=$(tunnel_ip); port=$(forwarded_port)
  [ -n "$ip" ] && [ -n "$port" ] && docker exec gluetun sh -c "netstat -tuln | grep -q ' $ip:$port '"
}
chk "qbittorrent bound to the tunnel"    "qbit_on_tunnel"
# throttle-downloads switches on qBittorrent's alternative limit; at the 10 KiB/s default it would stall downloads.
chk "qbittorrent throttle cap set (not the 10 KiB/s default)" "[ \"\$(qbit_prefs | json_get alt_dl_limit)\" -ge 1000000 ]"
read -r UPLOAD_MBIT UPLOAD_CAP < <("$REPO/scripts/throttle-downloads" --upload-cap)
chk "qbittorrent upload capped at $UPLOAD_MBIT Mbps in both modes" "[ \"\$(qbit_prefs | json_get up_limit)\" -eq $UPLOAD_CAP ] && [ \"\$(qbit_prefs | json_get alt_up_limit)\" -eq $UPLOAD_CAP ]"
chk "forwarded port is in sync"          "test \"\$(forwarded_port)\" = \"\$(qbit_prefs | json_get listen_port)\""

echo
# Informational: an available update is not a failure.
UPD="$STATE_ROOT/updates"
if [ -f "$UPD" ]; then
  n=$(grep -c '^update ' "$UPD")
  when=$(sed -n 's/^checked=//p' "$UPD" | cut -c1-16 | tr T ' ')
  if [ "$n" -gt 0 ]; then
    printf "  \033[33mUPDATES\033[0m %s available (checked %s):\n" "$n" "$when"
    grep '^update ' "$UPD" | awk '{print "           " $2}'
  else
    printf "  UPDATES  all images current (checked %s)\n" "$when"
  fi
fi

echo "  $pass passed, $fail failed"

if [ "$fail" -gt 0 ] && [ "${1:-}" = "--notify" ]; then
  notify "media stack: $fail health check(s) failing" warning "$(printf '%s\n' "${failed[@]}")

Run scripts/health-check for details."
fi

[ "$fail" -eq 0 ]
