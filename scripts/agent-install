#!/usr/bin/env python3
"""Install the user service; never start it or replace any Pi/Telegram credentials."""
import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--enable", action="store_true", help="Enable service for subsequent user-manager boots (does not start it)")
    parser.add_argument("--profile", default="default", help="Existing paired pi-telegram profile")
    args = parser.parse_args()

    if os.geteuid() == 0:
        parser.error("Run as your own account, not root")

    repo = Path(__file__).resolve().parent.parent
    home = Path.home()

    node = shutil.which("node")
    pi = shutil.which("pi")
    if not node or not pi:
        parser.error("node and pi must already be installed and on PATH")

    cli = Path(pi).resolve()

    # Unit substitutions deliberately support simple absolute paths, not systemd specifiers/escaping.
    if any(any(c.isspace() or c in '%"\\' for c in str(p)) for p in (repo, home, node)):
        parser.error("Service installation requires paths without whitespace, quotes, backslashes or %")

    sys.path.insert(0, str(repo / "ai/agent"))
    from gateway import atomic_json, validate_config, validate_pairing, pi_version, telegram_version

    version = pi_version(cli)

    config_dir = home / ".config/arr-agent"
    config_file = config_dir / "config.json"
    state_dir = home / ".local/state/arr-agent"

    config = json.loads(config_file.read_text()) if config_file.exists() else {}
    config.update({"cwd": str(repo), "agentDir": str(home / ".pi/agent"), "stateDir": str(state_dir),
                   "node": str(Path(node).resolve()), "piCli": str(cli), "piVersion": version,
                   "profile": args.profile, "telegramVersion": telegram_version(home / ".pi/agent")})

    validate_config(config)
    validate_pairing(config)

    os.umask(0o077)
    for directory in (config_dir, state_dir):
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)

    if config_file.exists():
        shutil.copy2(config_file, config_dir / "config.previous.json")
    atomic_json(config_file, config)

    unit_dir = home / ".config/systemd/user"
    unit_dir.mkdir(parents=True, exist_ok=True)

    template = (repo / "ai/agent/arr-agent.service").read_text()
    unit = template.replace("@REPO@", str(repo)).replace("@HOME@", str(home)).replace("@NODE_BIN@", str(Path(node).parent))
    destination = unit_dir / "arr-agent.service"
    if destination.exists():
        shutil.copy2(destination, unit_dir / "arr-agent.service.previous")
    destination.write_text(unit)

    subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
    if args.enable:
        subprocess.run(["systemctl", "--user", "enable", "arr-agent.service"], check=True)

    print(f"Installed {destination}; pinned to Pi {version}, pi-telegram {config['telegramVersion']}. Not started.")
    print("Check: python3 ai/agent/gateway.py --check")
    print("Start: systemctl --user start arr-agent.service")
    print("Status: python3 ai/agent/gateway.py --status")
    print("For boot without login: sudo loginctl enable-linger " + home.name)


if __name__ == "__main__":
    main()
