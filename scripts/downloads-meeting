#!/usr/bin/env python3
"""Persistent Meeting mode and its tailnet-only Glance control.

Runs: arr-meeting.service; by hand for local development.
Changes: durable state, qBittorrent stop/start and add-stopped preference, only after a UI command.
Idempotent: yes; repeated reconciliation enforces the same requested mode.
"""
import html
import json
import secrets
import threading
import time
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path


class Meeting:
    def __init__(self, path, api, clock=time.time):
        self.path, self.api, self.clock = Path(path), api, clock
        self.lock = threading.RLock()
        self.error = None
        self.confirmed = False
        self.state = json.loads(self.path.read_text()) if self.path.exists() else None

    def save(self):
        self.path.parent.mkdir(parents=True, exist_ok=True)
        tmp = self.path.with_suffix('.tmp')
        tmp.write_text(json.dumps(self.state))
        tmp.chmod(0o600)
        tmp.replace(self.path)

    def change(self, mode, seconds=0):
        with self.lock:
            if mode == 'on':
                if not self.state:
                    torrents = self.api('/torrents/info')
                    self.state = {'phase': 'on', 'resume': [],
                                  'original_stopped': [t['hash'] for t in torrents if self.stopped(t)],
                                  'add_stopped': self.api('/app/preferences')['add_stopped_enabled'],
                                  'until': 0}
                self.state.update(phase='on', until=self.clock() + seconds if seconds else 0)
            elif mode == 'off' and self.state:
                self.state['phase'] = 'off'
            self.save()
            self.reconcile()

    @staticmethod
    def stopped(torrent):
        return torrent['state'].startswith(('stopped', 'paused'))

    def reconcile(self):
        with self.lock:
            self.confirmed = False
            try:
                if not self.state:
                    self.error = None
                    self.confirmed = True
                    return
                if self.state['until'] and self.clock() >= self.state['until']:
                    self.state['phase'] = 'off'
                    self.save()
                if self.state['phase'] == 'on':
                    torrents = self.api('/torrents/info')
                    active = [t['hash'] for t in torrents if not self.stopped(t)]
                    restore = set(self.state['resume']) | (set(active) - set(self.state['original_stopped']))
                    if self.state['resume'] != sorted(restore):
                        self.state['resume'] = sorted(restore)
                        self.save()
                    if not self.api('/app/preferences')['add_stopped_enabled']:
                        self.api('/app/setPreferences', {'json': json.dumps({'add_stopped_enabled': True})})
                    if active:
                        self.api('/torrents/stop', {'hashes': 'all'})
                        torrents = self.api('/torrents/info')
                    self.confirmed = all(self.stopped(t) for t in torrents)
                    if not self.confirmed:
                        raise RuntimeError('Transfers are still stopping')
                else:
                    self.api('/app/setPreferences', {'json': json.dumps({'add_stopped_enabled': self.state['add_stopped']})})
                    if self.state['resume']:
                        self.api('/torrents/start', {'hashes': '|'.join(self.state['resume'])})
                    self.state = None
                    self.save()
                    self.confirmed = True
                self.error = None
            except Exception:
                self.error = 'Cannot confirm torrent state. Retrying automatically.'

    def status(self):
        with self.lock:
            return {'enabled': bool(self.state and self.state['phase'] == 'on'),
                    'confirmed': self.confirmed, 'error': self.error,
                    'until': self.state['until'] if self.state else 0}


def handler(controller, allowed_hosts):
    token = secrets.token_urlsafe(32)

    class Handler(BaseHTTPRequestHandler):
        def setup(self):
            super().setup()
            self.connection.settimeout(5)

        def log_message(self, *_args):
            pass

        def respond(self, code, body, content_type='application/json'):
            self.send_response(code)
            self.send_header('Content-Type', content_type)
            self.send_header('Cache-Control', 'no-store')
            self.send_header('Content-Security-Policy', "default-src 'self'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; frame-ancestors " + ' '.join('http://' + h.rsplit(':', 1)[0] + ':3005' for h in allowed_hosts))
            self.send_header('X-Content-Type-Options', 'nosniff')
            self.end_headers()
            self.wfile.write(body.encode())

        def do_GET(self):
            if self.headers.get('Host') not in allowed_hosts:
                self.respond(403, '{}')
            elif self.path == '/status':
                self.respond(200, json.dumps(controller.status()))
            elif self.path == '/':
                page = (Path(__file__).resolve().parent.parent / 'apps/glance/meeting.html').read_text()
                self.respond(200, page.replace('@TOKEN@', html.escape(token)), 'text/html; charset=utf-8')
            else:
                self.respond(404, '{}')

        def do_POST(self):
            host = self.headers.get('Host')
            if (host not in allowed_hosts or self.headers.get('Origin') != 'http://' + host
                    or self.headers.get('X-Meeting-Token') != token or self.path != '/mode'):
                self.respond(403, '{}')
                return
            try:
                length = int(self.headers.get('Content-Length', '0'))
                if not 0 < length <= 256:
                    raise ValueError()
                data = json.loads(self.rfile.read(length))
                if data.get('mode') not in ('on', 'off') or data.get('seconds', 0) not in (0, 3600):
                    raise ValueError()
                controller.change(data['mode'], data.get('seconds', 0))
                self.respond(200, json.dumps(controller.status()))
            except (ValueError, KeyError, TypeError):
                self.respond(400, '{}')
            except Exception:
                self.respond(503, json.dumps({'error': 'Controller unavailable. Please retry.'}))

    return Handler


def main():
    from stack_env import ENV, STATE

    base = f"http://127.0.0.1:{ENV['QBIT_PORT']}/api/v2"

    def api(path, form=None):
        data = urllib.parse.urlencode(form).encode() if form is not None else None
        with urllib.request.urlopen(urllib.request.Request(base + path, data=data), timeout=5) as response:
            raw = response.read()
            return json.loads(raw) if raw else None

    controller = Meeting(STATE / 'meeting.json', api)

    def enforce():
        while True:
            controller.reconcile()
            time.sleep(2)

    threading.Thread(target=enforce, daemon=True).start()
    hosts = {f"{name}:4536" for name in (ENV['HOST_NAME'], ENV['HOST_NAME'] + '.local', ENV['TAILSCALE_IP'])}
    server = HTTPServer((ENV['TAILSCALE_IP'], 4536), handler(controller, hosts))
    server.timeout = 5
    server.serve_forever()


if __name__ == '__main__':
    main()
