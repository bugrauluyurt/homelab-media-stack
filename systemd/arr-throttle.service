[Unit]
Description=Cap qBittorrent while someone is watching or the Pi is overloaded
# The whole stack is down while the drive is off; nothing to throttle then.
ConditionPathIsMountPoint=@STORAGE_MOUNT@
After=arr-stack.service

[Service]
Type=oneshot
User=@STACK_USER@
Group=@STACK_GROUP@
ExecStart=@REPO@/scripts/throttle-downloads
