[Unit]
Description=Mirror the media drive onto the backup drive (rsync, 30-day trash)
# The media drive is powered by hand; skip rather than fail when it's off. A missing backup drive fails loudly.
ConditionPathIsMountPoint=@STORAGE_MOUNT@
After=@STORAGE_UNIT@ @BACKUP_UNIT@
OnFailure=arr-notify-failure@%n.service

[Service]
Type=oneshot
ExecStart=@REPO@/scripts/storage-mirror
# A first copy of a full drive can take most of a day; longer than that it is hung, and failing alerts.
TimeoutStartSec=24h
# A requested stop exits 143 after remounting read-only; a timeout still fails with result 'timeout'.
SuccessExitStatus=143
Nice=19
IOSchedulingClass=idle
