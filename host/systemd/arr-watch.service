[Unit]
Description=Alert on transcodes, new Jellyfin devices, failed logins and stuck requests
# The whole stack is down while the drive is off; nothing to watch then.
ConditionPathIsMountPoint=@STORAGE_MOUNT@
After=arr-stack.service

[Service]
Type=oneshot
User=@STACK_USER@
Group=@STACK_GROUP@
ExecStart=@REPO@/scripts/watch-activity
