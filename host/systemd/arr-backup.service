[Unit]
Description=Back up media-stack settings to the media drive and the system disk (restic)
# The drive is powered by hand; skip rather than fail when it's off.
ConditionPathIsMountPoint=@STORAGE_MOUNT@
After=@STORAGE_UNIT@ docker.service
OnFailure=arr-notify-failure@%n.service

[Service]
Type=oneshot
ExecStart=@REPO@/scripts/stack-backup
Nice=10
IOSchedulingClass=idle
