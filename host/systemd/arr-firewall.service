[Unit]
Description=Host firewall: home network gets Jellyfin, Seerr and the games page only
After=docker.service tailscaled.service network-online.target
Wants=network-online.target
OnFailure=arr-notify-failure@%n.service

[Service]
Type=oneshot
ExecStart=@REPO@/scripts/host-firewall

[Install]
WantedBy=multi-user.target
