// Tailscale access policy for this stack. Tailscale keeps the live copy: paste
// this into https://login.tailscale.com/admin/acls/file (JSON editor), with the
// placeholder emails replaced, then tag the Pi: Machines → the Pi → ⋯ →
// Edit ACL tags → tag:media.
//
// - You (every device you sign in to) reach everything.
// - Each viewer (a Member of your tailnet, listed in group:viewers) reaches only
//   Jellyfin (8096), Seerr (5055), Questarr (5000), game downloads (8090 web,
//   2022 SFTP) and Needle (4535, music) on the Pi, and none of your other devices.
//   Navidrome itself (4533) stays closed: Needle passes music through. Access follows the person:
//   don't tag their devices, or they stop counting as that person.
// - The Pi is tagged, so it owns nothing and may start no connections: if it
//   were compromised, it couldn't reach your laptops or phones.
// Never put back the default {"src": ["*"], "dst": ["*"]} grant: rules only
// ever add access, so it would cancel all of the above.
{
    "groups": {
        "group:viewers": ["VIEWER@example.com"],
    },

    "tagOwners": {"tag:media": ["autogroup:admin"]},

    "grants": [
        {"src": ["YOU@example.com"], "dst": ["*"], "ip": ["*"]},
        {"src": ["group:viewers"], "dst": ["tag:media"], "ip": ["tcp:8096", "tcp:5055", "tcp:5000", "tcp:8090", "tcp:2022", "tcp:4535"]},
    ],

    "ssh": [
        {"action": "check", "src": ["autogroup:member"], "dst": ["autogroup:self"], "users": ["autogroup:nonroot", "root"]},
    ],

    "tests": [
        {"src": "VIEWER@example.com", "accept": ["tag:media:8096", "tag:media:5055", "tag:media:5000", "tag:media:8090", "tag:media:2022", "tag:media:4535"],
         "deny": ["tag:media:8989", "tag:media:8080", "tag:media:3005", "tag:media:3006", "tag:media:3007", "tag:media:4533", "tag:media:22"]},
        {"src": "YOU@example.com", "accept": ["tag:media:3000", "tag:media:4535", "tag:media:22"]},
    ],
}
