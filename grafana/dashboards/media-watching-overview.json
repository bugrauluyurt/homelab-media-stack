{
  "id": null,
  "uid": "media-watching-overview",
  "title": "Media Server: Watching",
  "description": "Recorded Jellyfin playback from Jellystat, queried with a column-scoped read-only database role.",
  "tags": [
    "arr-stack",
    "overview"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
