    {
      "id": 8,
      "title": "Viewing by user",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jellystat-readonly"
          },
          "rawSql": "SELECT coalesce(\"UserName\",'Unknown') AS \"Viewer\", count(*) AS \"Sessions\", round(sum(\"PlaybackDuration\")/3600.0,2) AS \"Hours\", max(\"ActivityDateInserted\") AS \"Latest record\" FROM public.jf_playback_activity WHERE $__timeFilter(\"ActivityDateInserted\") GROUP BY \"UserId\",\"UserName\" ORDER BY \"Hours\" DESC",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jellystat-readonly"
      }
    },
    {
      "id": 9,
      "title": "Most watched titles / series",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
