      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jellystat-readonly"
          },
          "rawSql": "SELECT \"ActivityDateInserted\" AS \"Recorded at\", \"UserName\" AS \"Viewer\", coalesce(nullif(\"SeriesName\",'') || ': ' ,'') || coalesce(\"NowPlayingItemName\",'Unknown') AS \"Title\", round(\"PlaybackDuration\"/60.0,1) AS \"Minutes\", \"PlayMethod\" AS \"Method\" FROM public.jf_playback_activity WHERE $__timeFilter(\"ActivityDateInserted\") ORDER BY \"ActivityDateInserted\" DESC LIMIT 50",
