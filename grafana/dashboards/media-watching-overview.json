      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jellystat-readonly"
          },
          "rawSql": "SELECT coalesce(sum(\"PlaybackDuration\"),0) AS \"Recorded watch time\" FROM public.jf_playback_activity WHERE $__timeFilter(\"ActivityDateInserted\")",
          "format": "table",
