    {
      "id": 6,
      "title": "Recorded watch hours by day",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "description": "UTC day buckets, displayed in browser timezone. Full durations assigned to record timestamp. Missing days are not fabricated.",
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jellystat-readonly"
          },
          "rawSql": "SELECT date_trunc('day', \"ActivityDateInserted\" AT TIME ZONE 'UTC') AT TIME ZONE 'UTC' AS \"time\", sum(\"PlaybackDuration\")/3600.0 AS \"Hours\" FROM public.jf_playback_activity WHERE $__timeFilter(\"ActivityDateInserted\") GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jellystat-readonly"
      }
    },
