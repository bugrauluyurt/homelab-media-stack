  "panels": [
    {
      "id": 1,
      "title": "About this dashboard",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "**Recorded Jellyfin viewing activity, not a live Now Playing feed.** Uses existing Jellystat history; no tracking before Jellystat was installed. The selected range filters each record by its ActivityDateInserted timestamp. Full recorded durations are assigned to that timestamp, not split across days; sessions may be partial or repeated. CPU history and watching history are available separately through the links above."
      },
      "targets": []
    },
    {
      "id": 2,
      "title": "Recorded sessions",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jellystat-readonly"
          },
          "rawSql": "SELECT count(*) AS \"Recorded sessions\" FROM public.jf_playback_activity WHERE $__timeFilter(\"ActivityDateInserted\")",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jellystat-readonly"
      }
    },
    {
