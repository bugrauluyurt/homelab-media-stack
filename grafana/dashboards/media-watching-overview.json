        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "jellystat-readonly"
          },
          "rawSql": "SELECT coalesce(nullif(\"SeriesName\",''),\"NowPlayingItemName\",'Unknown') AS \"Title\", count(*) AS \"Sessions\", round(sum(\"PlaybackDuration\")/3600.0,2) AS \"Hours\" FROM public.jf_playback_activity WHERE $__timeFilter(\"ActivityDateInserted\") GROUP BY 1 ORDER BY \"Hours\" DESC LIMIT 15",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "jellystat-readonly"
