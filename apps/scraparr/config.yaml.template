# Template only. scraparr has no env-var interpolation, so the rendered
# file would contain live API keys - it is written to $CONFIG_ROOT
# (outside this repo) by scripts/configure-scraparr.
general:
  port: 7100
  # The arr APIs are not fast; keep this well under Prometheus' 60s interval.
  refresh_interval: 45

sonarr:
  - url: http://sonarr:8989
    api_key: __SONARR_API_KEY__

radarr:
  - url: http://radarr:7878
    api_key: __RADARR_API_KEY__

prowlarr:
  - url: http://prowlarr:9696
    api_key: __PROWLARR_API_KEY__

bazarr:
  - url: http://bazarr:6767
    api_key: __BAZARR_API_KEY__
