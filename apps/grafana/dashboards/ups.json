{
  "id": null,
  "uid": "arr-ups",
  "title": "UPS",
  "description": "APC UPS state from apcupsd, written by the node-exporter textfile collector and scraped every 30 seconds.",
  "tags": [
    "homelab-media-stack"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ],
    "time_options": [
      "1h",
      "6h",
      "24h",
      "7d",
      "30d"
    ]
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Power",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "description": "On mains, on battery, or apcupsd cannot talk to the UPS.",
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "UPS not responding",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "On mains",
                  "color": "green",
                  "index": 1
                },
                "2": {
                  "text": "On battery",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "arr_ups_up * (1 + arr_ups_on_battery)",
          "legendFormat": "Power",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": false,
          "instant": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
